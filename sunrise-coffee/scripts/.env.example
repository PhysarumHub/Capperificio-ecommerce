# ═══════════════════════════════════════════════════════════════════
#  Script Shopware — Variabili d'ambiente
#
#  1. Copia questo file: cp scripts/.env.example scripts/.env
#  2. Compila i valori reali in scripts/.env
#  3. scripts/.env è in .gitignore — NON verrà mai committato
# ═══════════════════════════════════════════════════════════════════

# URL base del tuo server Shopware (senza /api, senza slash finale)
# Es: http://157.90.xxx.xxx:8090  oppure  https://shop.capperificiocaro.com
SHOPWARE_URL=https://IL-TUO-SHOPWARE.com

# Credenziali admin Shopware
# Shopware Admin → Settings → Users → il tuo utente
SHOPWARE_ADMIN_USER=admin
SHOPWARE_ADMIN_PASS=LA-TUA-PASSWORD-SICURA

# Access Key del Sales Channel Headless (Store API)
# Shopware Admin → Sales Channels → Headless → API Access Key (inizia con SWSC...)
VITE_SHOPWARE_ACCESS_KEY=SWSC...
