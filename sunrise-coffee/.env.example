# ═══════════════════════════════════════════════════════════════════
#  CAPPERIFICIO — Variabili d'ambiente
#  Copia questo file in .env e compila tutti i valori
# ═══════════════════════════════════════════════════════════════════

# ── Shopware 6 ──────────────────────────────────────────────────────
# URL della Store API del tuo Shopware (senza slash finale)
# Es: https://shop.capperificio.it/store-api
VITE_SHOPWARE_API_URL=https://TUO-SHOPWARE.com/store-api

# Chiave di accesso del Sales Channel Headless
# Shopware Admin → Canali di vendita → Headless → Chiave API (inizia con SWSC...)
VITE_SHOPWARE_ACCESS_KEY=SWSC...

# URL del dominio configurato nel Sales Channel (usato per i guest)
# Shopware Admin → Canali di vendita → [canale] → Domini
VITE_SHOPWARE_STOREFRONT_URL=https://TUO-FRONTEND.vercel.app

# ── Stripe ──────────────────────────────────────────────────────────
# Dashboard TEST:  https://dashboard.stripe.com/test/apikeys
# Dashboard LIVE:  https://dashboard.stripe.com/apikeys
#
# Per andare live: sostituisci pk_test_ con pk_live_ e sk_test_ con sk_live_
VITE_STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

# ── PayPal ──────────────────────────────────────────────────────────
# Sandbox: https://developer.paypal.com/dashboard/applications/sandbox
# Live:    https://developer.paypal.com/dashboard/applications/live
#
# 1. Vai su developer.paypal.com → My Apps & Credentials
# 2. Crea o seleziona un'app
# 3. Copia il "Client ID" (non il secret)
VITE_PAYPAL_CLIENT_ID=AXxx...

# ── Strapi CMS (blog) ───────────────────────────────────────────────
# URL pubblico del server Strapi
VITE_STRAPI_URL=https://TUO-STRAPI.com
# Token API read-only → Strapi Admin → Settings → API Tokens
VITE_STRAPI_TOKEN=

# ── B2B ─────────────────────────────────────────────────────────────
# ID categoria B2B (ottieni da: python scripts/setup-b2b.py)
VITE_B2B_CATEGORY_ID=
VITE_B2B_GROUP_NAME=B2B

# ── Solo per lo sviluppo locale ─────────────────────────────────────
# (Non serve su Vercel — lì si usano le env vars del progetto)
# FRONTEND_URL=http://localhost:5173
