# ═══════════════════════════════════════════════════════════════════
#  CAPPERIFICIO — Variabili d'ambiente
#
#  Per lo sviluppo locale:
#    cp .env.example .env.local   (non verrà mai committato)
#
#  Per la produzione (VPS self-hosted con Docker Compose):
#    cp .env.example .env   sul server, poi compila i valori reali.
#    docker-compose.yml legge questo file sia per i build arg VITE_*
#    sia per le variabili runtime di server.js.
#
#  REGOLA: tutto ciò che ha prefisso VITE_ finisce nel bundle JS PUBBLICO.
#          I segreti (sk_, client secret, token) NON devono mai avere VITE_.
# ═══════════════════════════════════════════════════════════════════

# ── Shopware 6 (browser) ────────────────────────────────────────────
# URL della Store API (senza slash finale)
VITE_SHOPWARE_API_URL=https://TUO-SHOPWARE.com/store-api
# Chiave del Sales Channel Headless (inizia con SWSC...) — pubblica, ok nel bundle
VITE_SHOPWARE_ACCESS_KEY=SWSC...
# URL del frontend (guest registration + CORS)
VITE_SHOPWARE_STOREFRONT_URL=https://www.capperificiocaro.com

# ── Shopware 6 (server) ─────────────────────────────────────────────
# ⚠ STESSI valori dei VITE_ qui sopra ma SENZA prefisso, lato server.
#   Usati dal backend per leggere il carrello REALE e calcolare l'importo
#   lato server (blocca la manipolazione del prezzo). OBBLIGATORI.
SHOPWARE_API_URL=https://TUO-SHOPWARE.com/store-api
SHOPWARE_ACCESS_KEY=SWSC...

# ── Shopware 6 — Admin API (per segnare gli ordini "pagati") ────────
#   Dopo il pagamento il server transiziona la transazione dell'ordine a "paid".
#   CONSIGLIATO: crea un'Integration in Shopware admin
#     Settings → System → Integrations → "Add integration" (ruolo: Administrator)
#   e incolla qui client_id / client_secret.
SHOPWARE_ADMIN_API_URL=https://TUO-SHOPWARE.com/api
SHOPWARE_ADMIN_CLIENT_ID=
SHOPWARE_ADMIN_CLIENT_SECRET=
#   Fallback solo per sviluppo (dockware): user/password admin invece dell'integration.
SHOPWARE_ADMIN_USERNAME=
SHOPWARE_ADMIN_PASSWORD=

# ── Stripe (PAGAMENTO UNIFICATO) ────────────────────────────────────
# Un solo Stripe Payment Element gestisce carta + Apple/Google Pay + Link + PayPal.
# Attiva i metodi desiderati in: Dashboard → Settings → Payment methods.
# Chiavi TEST:  https://dashboard.stripe.com/test/apikeys   (usa queste in sviluppo)
# Chiavi LIVE:  https://dashboard.stripe.com/apikeys        (solo al go-live)
VITE_STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
# Signing secret del webhook (Stripe Dashboard → Developers → Webhooks)
# Eventi da abilitare: payment_intent.succeeded, charge.refunded
# URL webhook: https://www.capperificiocaro.com/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# Secret condiviso per l'endpoint di rimborso POST /api/admin/refund (nessun
# pannello admin/login in questo backend: la richiesta va autenticata con
# l'header `x-admin-key`). Genera un valore lungo e casuale, es.:
#   openssl rand -hex 32
# ⚠ Trattalo come STRIPE_SECRET_KEY: /api non è ristretto a 127.0.0.1 in nginx,
# quindi questo endpoint è raggiungibile da internet, protetto solo da questo secret.
ADMIN_API_KEY=

# ── PayPal ──────────────────────────────────────────────────────────
# Rimosso: nessuna integrazione PayPal attiva. Quando lo vorrai aggiungere,
# abilitalo come metodo dentro il Payment Element di Stripe (Dashboard Stripe
# → Settings → Payment methods): non serve nessuna variabile qui, e le pagine
# legali/FAQ vanno aggiornate per dichiararlo di nuovo tra i metodi accettati.

# ── Strapi CMS (blog) ───────────────────────────────────────────────
# Strapi NON è esposto su internet (porta 1337 bound su 127.0.0.1).
#
# URL base dei src immagine nel browser = dominio del SITO: le cover passano
# dal proxy nginx (location /uploads → strapi:1337). Lascia vuoto se non usi
# Strapi (il blog viene disattivato).
VITE_STRAPI_URL=https://tuodominio.com
# ⚠ Token Strapi SOLO lato server (proxy /api/strapi). NON usare VITE_.
# Hostname interno alla rete Docker, non l'IP pubblico.
STRAPI_URL=http://strapi:1337
STRAPI_TOKEN=
# URL con cui raggiungi l'admin Strapi — via tunnel SSH resta localhost.
STRAPI_PUBLIC_URL=http://localhost:1337

# ── Packlink PRO (spedizioni automatiche) ───────────────────────────
# Chiave API: pro.packlink.com → Impostazioni → Integrazioni → API
# Lascia vuoto finché non hai l'account: le spedizioni verranno saltate
# senza errori e l'ordine va comunque a buon fine.
PACKLINK_API_KEY=

# Indirizzo mittente (default: Capperificio di Racale, Racale LE)
PACKLINK_SENDER_ZIP=73055
PACKLINK_SENDER_COUNTRY=IT
PACKLINK_SENDER_CITY=Racale
PACKLINK_SENDER_STATE=LE
PACKLINK_SENDER_STREET=Via Montesanto 64
PACKLINK_SENDER_NAME=Capperificio di Racale
PACKLINK_SENDER_EMAIL=info@capperificiocaro.com
PACKLINK_SENDER_PHONE=+390000000000

# Dimensioni medie del pacco (modifica in base ai tuoi imballaggi)
PACKLINK_CONTENT=Capperi artigianali di Racale
PACKLINK_PKG_WEIGHT_KG=1.5
PACKLINK_PKG_WIDTH_CM=22
PACKLINK_PKG_HEIGHT_CM=12
PACKLINK_PKG_LENGTH_CM=28

# ── Resend (email transazionali) ────────────────────────────────────
# Documentazione: https://resend.com/docs
# 1. Crea account su resend.com
# 2. Aggiungi e verifica il dominio capperificiocaro.com (DNS → MX + DKIM)
# 3. Crea un API key (resend.com/api-keys)
RESEND_API_KEY=re_...
# Mittente (deve usare il dominio verificato)
RESEND_FROM=Capperificio di Racale <ordini@capperificiocaro.com>
# Email merchant: riceve la notifica per ogni nuovo ordine
RESEND_MERCHANT_TO=digital@capperificiocaro.com

# ── B2B ─────────────────────────────────────────────────────────────
VITE_B2B_CATEGORY_ID=
VITE_B2B_GROUP_NAME=B2B

# ── Analytics — Google Tag Manager ──────────────────────────────────
# Container ID nel formato GTM-XXXXXXX. Lasciandolo vuoto GTM non viene
# caricato affatto (nessuna richiesta a googletagmanager.com), quindi il
# sito resta cookie-free finché non lo valorizzi.
# Va passato al BUILD (è una var VITE_*), non al runtime.
# Il consenso è già gestito da Consent Mode v2 in index.html.
VITE_GTM_ID=

# ── Server Express ──────────────────────────────────────────────────
# server.js è l'UNICO backend: espone /api/checkout/*, /api/newsletter/*,
# /api/stripe/webhook, /api/admin/refund, /api/strapi/* e /sitemap.xml.
# Gira nel container `frontend` dietro nginx (location /api → 127.0.0.1:3001).
#
# ATTENZIONE — con Docker la variabile da valorizzare è SITE_URL:
# docker-compose.yml fa `FRONTEND_URL: ${SITE_URL:-http://localhost}`,
# quindi legge SITE_URL e ignora FRONTEND_URL. Se SITE_URL è vuota,
# l'origine CORS di Express resta http://localhost e il browser blocca
# tutte le chiamate a /api dal dominio pubblico: il checkout non parte.
# Deve combaciare esattamente con l'host canonico (www).
SITE_URL=https://www.capperificiocaro.com

# Usata solo eseguendo `node server.js` fuori da Docker (npm run dev).
FRONTEND_URL=https://www.capperificiocaro.com
PORT=3001
NODE_ENV=production
