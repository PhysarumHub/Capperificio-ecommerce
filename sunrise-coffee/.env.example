# ═══════════════════════════════════════════════════════════════════
#  CAPPERIFICIO — Variabili d'ambiente
#
#  Per lo sviluppo locale:
#    cp .env.example .env.local   (non verrà mai committato)
#
#  Per la produzione:
#    Inserisci questi valori su Vercel → Settings → Environment Variables
#    NON creare un file .env in produzione
# ═══════════════════════════════════════════════════════════════════

# ── Shopware 6 ──────────────────────────────────────────────────────
# URL della Store API (senza slash finale)
# Shopware Admin → Sales Channels → Headless → API Access → Store API URL
VITE_SHOPWARE_API_URL=https://TUO-SHOPWARE.com/store-api

# Chiave del Sales Channel Headless (inizia con SWSC...)
# Shopware Admin → Sales Channels → Headless → API Access Key
VITE_SHOPWARE_ACCESS_KEY=SWSC...

# URL del tuo frontend (usato da Shopware per guest registration e CORS)
# In produzione: https://capperificiocaro.com
# In locale:     http://localhost:5173
VITE_SHOPWARE_STOREFRONT_URL=https://capperificiocaro.com

# ── Stripe ──────────────────────────────────────────────────────────
# Chiavi TEST:  https://dashboard.stripe.com/test/apikeys
# Chiavi LIVE:  https://dashboard.stripe.com/apikeys
#
# ⚠ VITE_STRIPE_PUBLIC_KEY  → inclusa nel bundle JS (ok per il browser)
# ⚠ STRIPE_SECRET_KEY       → solo lato server — NON deve mai avere il prefisso VITE_
VITE_STRIPE_PUBLIC_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...

# ── PayPal ──────────────────────────────────────────────────────────
# Client ID della tua app PayPal (NON il secret)
# Live:    https://developer.paypal.com/dashboard/applications/live
# Sandbox: https://developer.paypal.com/dashboard/applications/sandbox
#
# PayPal riconosce automaticamente live vs sandbox dal Client ID:
#   - live:    inizia con AXxx... (production)
#   - sandbox: inizia con AXxx... ma dall'app sandbox
VITE_PAYPAL_CLIENT_ID=AXxx...

# ── Strapi CMS (blog) ───────────────────────────────────────────────
# Lascia vuoto se non usi Strapi
VITE_STRAPI_URL=https://TUO-STRAPI.com
# Token read-only → Strapi Admin → Settings → API Tokens → Create
VITE_STRAPI_TOKEN=

# ── B2B ─────────────────────────────────────────────────────────────
# ID categoria B2B in Shopware (ottieni con: python scripts/audit-shopware.py)
VITE_B2B_CATEGORY_ID=
VITE_B2B_GROUP_NAME=B2B

# ── Server Express locale (NON usato su Vercel) ─────────────────────
# Su Vercel le API girano come serverless functions in /api
# Queste variabili servono solo per: npm run dev  (locale)
FRONTEND_URL=https://capperificiocaro.com
PORT=3001
NODE_ENV=production
