# ═══════════════════════════════════════════════════════════════════
#  CAPPERIFICIO — Variabili d'ambiente
#
#  Per lo sviluppo locale:
#    cp .env.example .env.local   (non verrà mai committato)
#
#  Per la produzione:
#    Inserisci questi valori su Vercel → Settings → Environment Variables
#    NON creare un file .env in produzione
#
#  REGOLA: tutto ciò che ha prefisso VITE_ finisce nel bundle JS PUBBLICO.
#          I segreti (sk_, client secret, token) NON devono mai avere VITE_.
# ═══════════════════════════════════════════════════════════════════

# ── Shopware 6 (browser) ────────────────────────────────────────────
# URL della Store API (senza slash finale)
VITE_SHOPWARE_API_URL=https://TUO-SHOPWARE.com/store-api
# Chiave del Sales Channel Headless (inizia con SWSC...) — pubblica, ok nel bundle
VITE_SHOPWARE_ACCESS_KEY=SWSC...
# URL del frontend (guest registration + CORS)
VITE_SHOPWARE_STOREFRONT_URL=https://capperificiocaro.com

# ── Shopware 6 (server) ─────────────────────────────────────────────
# ⚠ STESSI valori dei VITE_ qui sopra ma SENZA prefisso, lato server.
#   Usati dalle serverless function per leggere il carrello REALE e calcolare
#   l'importo lato server (blocca la manipolazione del prezzo). OBBLIGATORI.
SHOPWARE_API_URL=https://TUO-SHOPWARE.com/store-api
SHOPWARE_ACCESS_KEY=SWSC...

# ── Stripe ──────────────────────────────────────────────────────────
# Chiavi TEST:  https://dashboard.stripe.com/test/apikeys
# Chiavi LIVE:  https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLIC_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
# Signing secret del webhook (Stripe Dashboard → Developers → Webhooks)
# Evento da abilitare: payment_intent.succeeded
# URL webhook: https://capperificiocaro.com/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# ── PayPal ──────────────────────────────────────────────────────────
# Client ID → nel browser (pubblico)
VITE_PAYPAL_CLIENT_ID=AXxx...
# ⚠ Client ID + SECRET lato server: la creazione/cattura ordine avviene sul
#   server con importo dal carrello. Il SECRET non deve mai stare nel bundle.
PAYPAL_CLIENT_ID=AXxx...
PAYPAL_CLIENT_SECRET=EXxx...
# https://api-m.paypal.com (live)  oppure  https://api-m.sandbox.paypal.com (test)
PAYPAL_API_BASE=https://api-m.paypal.com

# ── Strapi CMS (blog) ───────────────────────────────────────────────
# URL pubblico (solo per le immagini). Lascia vuoto se non usi Strapi.
VITE_STRAPI_URL=https://TUO-STRAPI.com
# ⚠ Token Strapi SOLO lato server (proxy /api/strapi). NON usare VITE_.
STRAPI_URL=https://TUO-STRAPI.com
STRAPI_TOKEN=

# ── B2B ─────────────────────────────────────────────────────────────
VITE_B2B_CATEGORY_ID=
VITE_B2B_GROUP_NAME=B2B

# ── Server Express locale ───────────────────────────────────────────
# Su Vercel le API girano come serverless functions in /api.
# Queste servono per: npm run dev (locale) o self-hosting (Docker).
FRONTEND_URL=https://capperificiocaro.com
PORT=3001
NODE_ENV=production
